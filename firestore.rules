rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Funções auxiliares
    // ---------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.uid == 'tH4A7sYnH1WDUdBVDd1mfltMPdj2';
    }

    function isUserOwner(uid) {
      return isOwner() && request.auth.uid == uid;
    }

    function isValidFcmToken(data) {
      return data.keys().hasAll(['uid', 'token', 'enabled', 'keywords']) &&
             data.keys().hasOnly(['uid', 'token', 'enabled', 'keywords', 'createdAt', 'updatedAt', 'userAgent']) &&
             data.uid == request.auth.uid &&
             data.token is string && data.token.size() > 0 && data.token.size() <= 4096 &&
             data.enabled is bool &&
             data.keywords is list && data.keywords.size() <= 50 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 1024));
    }

    // ---------------------------------------------------------------
    // users/{uid}: documento raiz (groqApiKey editada só pelo console)
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isUserOwner(uid);
      allow write: if false;

      // Sincronização do app (users/{uid}/records/{id})
      match /records/{id} {
        allow read, write: if isUserOwner(uid);
      }

      // Demais subcoleções do usuário
      match /{subcollection}/{docId=**} {
        allow read, write: if isUserOwner(uid);
      }
    }

    // ---------------------------------------------------------------
    // Notícias do Ifes Campus Vitória (escrita só pelo Worker)
    // ---------------------------------------------------------------
    match /ifesNoticias/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Tokens FCM (Web Push): só o próprio dono
    // ---------------------------------------------------------------
    match /fcmTokens/{tokenId} {
      allow get: if isOwner() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if isOwner() && resource.data.uid == request.auth.uid;
      allow create: if isOwner() && isValidFcmToken(request.resource.data);
      allow update: if isOwner() &&
                    resource.data.uid == request.auth.uid &&
                    request.resource.data.uid == resource.data.uid &&
                    isValidFcmToken(request.resource.data);
      allow delete: if isOwner() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Metadados do coletor (meta/ifesNoticias): escrita só pelo Worker
    // ---------------------------------------------------------------
    match /meta/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}